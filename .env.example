# ---------------------------------------------------------------- database
# Local docker-compose:
DATABASE_URL=postgresql://dev:dev@localhost:5432/explainer
# Supabase — use the SESSION pooler (port 5432), not the transaction pooler:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------- artifact store
ARTIFACT_BACKEND=local          # local | s3
ARTIFACT_LOCAL_DIR=.artifacts
# S3 / Cloudflare R2 / Supabase Storage (S3-compatible):
# ARTIFACT_BACKEND=s3
# S3_BUCKET=explainer-artifacts
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_PREFIX=artifacts
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ------------------------------------------------------------------ models
# PINNED, never "latest" (PRD §6.6). Changing one is a deliberate migration
# that triggers a golden-set regression run.
MODEL_FRONTIER=claude-opus-5
MODEL_MID=claude-sonnet-5
MODEL_VISION=claude-sonnet-5
TTS_MODEL=unpinned
TTS_VOICE=unpinned
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------- runtime
APP_ENV=local
WORKER_POOLS=agent,render,media
HEARTBEAT_INTERVAL_S=15
HEARTBEAT_TIMEOUT_S=120
SERIES_COST_CAP_USD=250
